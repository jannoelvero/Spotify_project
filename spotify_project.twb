      <aliases enabled='yes' />
      <column caption='Duration Group' datatype='string' name='[Calculation_2869210044952578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [track_duration_min] &lt; 2 THEN &quot;Short&quot;&#10;ELSEIF [track_duration_min] &lt; 4 THEN &quot;Standard&quot;&#10;ELSEIF [track_duration_min] &lt; 6 THEN &quot;Long&quot;&#10;ELSE &quot;Very Long&quot;&#10;END' />
      </column>
      <column caption='Album Size Group' datatype='string' name='[Calculation_2869210046029827]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [album_total_tracks] &lt;= 5 THEN &quot;Small&quot;&#10;ELSEIF [album_total_tracks] &lt;= 12 THEN &quot;Medium&quot;&#10;ELSEIF [album_total_tracks] &lt;= 20 THEN &quot;Large&quot;&#10;ELSE &quot;Very Large&quot;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Release Decade  RQ8' datatype='integer' name='[Calculation_2869210054545414]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='FLOOR([release_year] / 10) * 10' />
      </column>
